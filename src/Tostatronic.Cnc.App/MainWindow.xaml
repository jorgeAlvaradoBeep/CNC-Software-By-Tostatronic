<Window x:Class="Tostatronic.Cnc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tostatronic PCB CNC"
        Width="1100" Height="760" MinWidth="980" MinHeight="640"
        Background="{StaticResource BgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- barra superior: conexión + estado + paro -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Puerto:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="110" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                          DropDownOpened="Ports_DropDownOpened" IsEnabled="{Binding IsConnected, Converter={StaticResource Inverse}}"/>
                <Button Content="Buscar" Margin="8,0,0,0" Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource Inverse}}"/>
                <Button Content="{Binding ConnectText}" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                        Command="{Binding ConnectCommand}"/>
                <CheckBox Content="Simulación (sin máquina)" Margin="14,0,0,0"
                          IsChecked="{Binding SimulationMode}"
                          IsEnabled="{Binding IsConnected, Converter={StaticResource Inverse}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#777"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="2" Content="⬛ PARO DE EMERGENCIA" Style="{StaticResource EStopButton}"
                    Padding="18,10" Command="{Binding EStopCommand}"/>
        </Grid>

        <!-- cuerpo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- columna izquierda: DRO + jog -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="POSICIÓN DE TRABAJO (mm)" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="X" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding XText}" Style="{StaticResource DroText}"/>
                            <Button Grid.Column="2" Content="0" Width="34" Height="30" Margin="12,2,0,2" Command="{Binding ZeroXCommand}" ToolTip="Fijar X0 aquí"/>
                            <TextBlock Grid.Row="1" Text="Y" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding YText}" Style="{StaticResource DroText}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="0" Width="34" Height="30" Margin="12,2,0,2" Command="{Binding ZeroYCommand}" ToolTip="Fijar Y0 aquí"/>
                            <TextBlock Grid.Row="2" Text="Z" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ZText}" Style="{StaticResource DroText}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="0" Width="34" Height="30" Margin="12,2,0,2" Command="{Binding ZeroZCommand}" ToolTip="Fijar Z0 aquí"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Cero X Y Z" Command="{Binding ZeroAllCommand}"/>
                            <Button Content="IR A CERO" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding GoZeroCommand}"/>
                            <TextBlock Text="⚠ sonda en contacto: sube Z+" Foreground="{StaticResource WarnBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding ProbeLatch, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelStyle}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="CONTROL MANUAL" Style="{StaticResource PanelTitle}"/>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource JogButton}" Tag="Y+"
                                    PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" MouseLeave="Jog_Leave"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="X−" Style="{StaticResource JogButton}" Tag="X-"
                                    PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" MouseLeave="Jog_Leave"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource JogButton}" Tag="X+"
                                    PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" MouseLeave="Jog_Leave"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Y−" Style="{StaticResource JogButton}" Tag="Y-"
                                    PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" MouseLeave="Jog_Leave"/>
                            <Button Grid.Row="0" Grid.Column="4" Content="Z+" Style="{StaticResource JogButton}" Tag="Z+"
                                    PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" MouseLeave="Jog_Leave"/>
                            <Button Grid.Row="2" Grid.Column="4" Content="Z−" Style="{StaticResource JogButton}" Tag="Z-"
                                    PreviewMouseLeftButtonDown="Jog_Down" PreviewMouseLeftButtonUp="Jog_Up" MouseLeave="Jog_Leave"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="Paso:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                            <RadioButton Content="Continuo" IsChecked="True" Checked="Step_Checked" Tag=""/>
                            <RadioButton Content="0.01" Checked="Step_Checked" Tag="0.01"/>
                            <RadioButton Content="0.1" Checked="Step_Checked" Tag="0.1"/>
                            <RadioButton Content="1" Checked="Step_Checked" Tag="1"/>
                            <RadioButton Content="10 mm" Checked="Step_Checked" Tag="10"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Velocidad:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <Slider Grid.Column="1" Minimum="10" Maximum="100" Margin="10,0"
                                    Value="{Binding SpeedPercent}" VerticalAlignment="Center"
                                    SmallChange="5" LargeChange="20"/>
                            <TextBlock Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center" Width="46" TextAlignment="Right"/>
                        </Grid>

                        <Button Margin="0,12,0,0" Height="42" Command="{Binding ToggleSpindleCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="HUSILLO: APAGADO"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SpindleOn}" Value="True">
                                            <Setter Property="Content" Value="HUSILLO: ENCENDIDO ⟳"/>
                                            <Setter Property="Background" Value="#7A5B1C"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="Teclas: ← → X · ↑ ↓ Y · Re Pág / Av Pág Z" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- columna derecha: trabajo de G-code -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" VerticalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TRABAJO (G-CODE)" Style="{StaticResource PanelTitle}"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Cargar G-code…" Command="{Binding LoadCommand}"/>
                        <Button Content="PCB desde Gerber…" Margin="8,0,0,0" Click="OpenCam_Click"/>
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding FileInfo}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="0,6,0,0"/>

                    <Grid DockPanel.Dock="Top" Margin="0,14,0,0">
                        <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     Background="#1A1B20" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource PanelBorderBrush}"/>
                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"/>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CurrentLineText}" FontFamily="Consolas" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ElapsedText}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button Content="▶ INICIO" Width="120" Height="46" FontSize="15" FontWeight="Bold"
                                Style="{StaticResource AccentButton}" Command="{Binding StartCommand}"/>
                        <Button Content="⏸ PAUSA" Width="110" Height="46" FontSize="15" Margin="10,0,0,0" Command="{Binding PauseCommand}"/>
                        <Button Content="⏹ PARADA" Width="110" Height="46" FontSize="15" Margin="10,0,0,0" Command="{Binding StopJobCommand}"/>
                        <Button Content="⟲ Reiniciar" Width="100" Height="46" Margin="10,0,0,0" Command="{Binding RewindCommand}"/>
                    </StackPanel>

                    <!-- calibración de altura -->
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,16,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="CALIBRACIÓN DE ALTURA" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding AutoLevelText}" Height="36" Command="{Binding AutoLevelCommand}"
                                        IsEnabled="{Binding IsCalibrating, Converter={StaticResource Inverse}}"/>
                                <CheckBox Content="Aplicar al trabajo" Margin="14,0,0,0"
                                          IsChecked="{Binding ApplyLeveling}"/>
                                <TextBlock Text="{Binding LevelingText}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Sondea la placa sobre las trayectorias de corte del G-code cargado (pinza de la sonda al cobre). Deja Z a pocos mm de la superficie: la sonda baja máximo 10 mm por punto. El contacto en X0 Y0 redefine Z0."/>
                        </StackPanel>
                    </Border>

                    <!-- aviso -->
                    <Border DockPanel.Dock="Top" Background="#4A3215" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastWarning}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Width="26" Height="24" Padding="0"
                                    Command="{Binding ClearWarningCommand}"/>
                            <TextBlock Text="{Binding LastWarning}" Foreground="{StaticResource WarnBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- consola -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,10,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="CONSOLA" Style="{StaticResource PanelTitle}" Margin="0"/>
                    <CheckBox Content="tráfico detallado (TX/RX)" HorizontalAlignment="Right"
                              IsChecked="{Binding DetailedLog}" FontSize="11"/>
                </DockPanel>
                <ListBox x:Name="ConsoleList" ItemsSource="{Binding ConsoleLines}"
                         Background="#141519" Foreground="#C9CAD3" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
